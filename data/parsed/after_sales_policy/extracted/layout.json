    "pdf_info": [
        {
            "para_blocks": [
                {
                    "type": "text",
                    "lines": [
                        {
                            "spans": [
                                {
                                    "type": "text",
                                    "content": "# 电商平台售后服务政策"
                                }
                            ]
                        }
                    ],
                    "index": 0
                },
                {
                    "type": "text",
                    "lines": [
                        {
                            "spans": [
                                {
                                    "type": "text",
                                    "content": "## 一、退货政策"
                                }
                            ]
                        }
                    ],
                    "index": 1
                },
                {
                    "type": "text",
                    "lines": [
                        {
                            "spans": [
                                {
                                    "type": "text",
                                    "content": "1. 用户收到商品后，支持在签收后的 7 天内申请退货。"
                                }
                            ]
                        }
                    ],
                    "index": 2
                },
                {
                    "type": "text",
                    "lines": [
                        {
                            "spans": [
                                {
                                    "type": "text",
                                    "content": "2. 退货商品应保持完好，不影响二次销售。"
                                }
                            ]
                        }
                    ],
                    "index": 3
                },
                {
                    "type": "text",
                    "lines": [
                        {
                            "spans": [
                                {
                                    "type": "text",
                                    "content": "3. 商品存在质量问题时，用户可以申请售后处理。"
                                }
                            ]
                        }
                    ],
                    "index": 4
                },
                {
                    "type": "text",
                    "lines": [
                        {
                            "spans": [
                                {
                                    "type": "text",
                                    "content": "4. 已超过退货期限的订单，需要由人工客服进一步审核。"
                                }
                            ]
                        }
                    ],
                    "index": 5
                },
                {
                    "type": "text",
                    "lines": [
                        {
                            "spans": [
                                {
                                    "type": "text",
                                    "content": "## 二、退款政策"
                                }
                            ]
                        }
                    ],
                    "index": 6
                },
                {
                    "type": "text",
                    "lines": [
                        {
                            "spans": [
                                {
                                    "type": "text",
                                    "content": "1. 用户申请退款时，需要提供订单编号和退款原因。"
                                }
                            ]
                        }
                    ],
                    "index": 7
                },
                {
                    "type": "text",
                    "lines": [
                        {
                            "spans": [
                                {
                                    "type": "text",
                                    "content": "2. 订单尚未签收时，退款申请需要根据订单实际状态审核。"
                                }
                            ]
                        }
                    ],
                    "index": 8
                },
                {
                    "type": "text",
                    "lines": [
                        {
                            "spans": [
                                {
                                    "type": "text",
                                    "content": "3. 商品存在质量问题时，可以申请退款或换货。"
                                }
                            ]
                        }
                    ],
                    "index": 9
                },
                {
                    "type": "text",
                    "lines": [
                        {
                            "spans": [
                                {
                                    "type": "text",
                                    "content": "4. 退款资格检查通过，不代表退款已经成功提交。"
                                }
                            ]
                        }
                    ],
                    "index": 10
                },
                {
                    "type": "text",
                    "lines": [
                        {
                            "spans": [
                                {
                                    "type": "text",
                                    "content": "5. 实际退款需要经过平台售后流程处理。"
                                }
                            ]
                        }
                    ],
                    "index": 11
                },
                {
                    "type": "text",
                    "lines": [
                        {
                            "spans": [
                                {
                                    "type": "text",
                                    "content": "## 三、商品质量问题"
                                }
                            ]
                        }
                    ],
                    "index": 12
                },
                {
                    "type": "text",
                    "lines": [
                        {
                            "spans": [
                                {
                                    "type": "text",
                                    "content": "1. 用户发现商品无法正常使用时，可以联系在线客服。"
                                }
                            ]
                        }
                    ],
                    "index": 13
                },
                {
                    "type": "text",
                    "lines": [
                        {
                            "spans": [
                                {
                                    "type": "text",
                                    "content": "2. 客服需要记录商品名称、订单编号和具体故障现象。"
                                }
                            ]
                        }
                    ],
                    "index": 14
                },
                {
                    "type": "text",
                    "lines": [
                        {
                            "spans": [
                                {
                                    "type": "text",
                                    "content": "3. 对于复杂质量问题，可以创建人工客服工单。"
                                }
                            ]
                        }
                    ],
                    "index": 15
                },
                {
                    "type": "text",
                    "lines": [
                        {
                            "spans": [
                                {
                                    "type": "text",
                                    "content": "4. 高优先级工单应优先安排人工处理。"
                                }
                            ]
                        }
                    ],
                    "index": 16
                },
                {
                    "type": "text",
                    "lines": [
                        {
                            "spans": [
                                {
                                    "type": "text",
                                    "content": "## 四、物流异常"
                                }
                            ]
                        }
                    ],
                    "index": 17
                },
                {
                    "type": "text",
                    "lines": [
                        {
                            "spans": [
                                {
                                    "type": "text",
                                    "content": "1. 用户可以通过订单编号查询物流状态。"
                                }
                            ]
                        }
                    ],
                    "index": 18
                },
                {
                    "type": "text",
                    "lines": [
                        {
                            "spans": [
                                {
                                    "type": "text",
                                    "content": "2. 物流长时间没有更新时，可以联系人工客服。"
                                }
                            ]
                        }
                    ],
                    "index": 19
                },
                {
                    "type": "text",
                    "lines": [
                        {
                            "spans": [
                                {
                                    "type": "text",
                                    "content": "3. 商品显示已签收但用户未收到时，需要创建物流异常工单。"
                                }
                            ]
                        }
                    ],
                    "index": 20
                }
            ],
